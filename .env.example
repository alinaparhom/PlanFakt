# Порт и адрес прослушивания. За nginx приложение слушает только localhost.
PORT=4173
HOST=127.0.0.1

# Длинная случайная строка, ею подписываются сессии: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret

# Токен бота из @BotFather. В репозиторий не попадает: .env закрыт в .gitignore.
TELEGRAM_BOT_TOKEN=123456789:replace-with-token-from-botfather
TELEGRAM_BOT_DISABLED=0

# Публичный адрес приложения — тот же, что указывается в @BotFather.
# Обязательно HTTPS и со слэшем на конце. Проверка: WEB_APP_URL + api/health
# должен вернуть {"ok":true,"service":"plan-fakt"}.
# Адресом приложения НЕ являются: путь к файлу .env, страница bmsu4.php,
# главная страница портала и 127.0.0.1 — приложение их отклонит.
WEB_APP_URL=https://bimmax.pro/planfakt/
TELEGRAM_BOT_USERNAME=OtchetFact_bot

# Сайты, которым разрешено обращаться к форме входа раздела (через запятую).
# Они же вправе открывать приложение во фрейме.
BMSU_SITE_ORIGINS=https://bimmax.pro

# Интерпретатор для чтения ведомостей XLSX/XLSB (openpyxl, pyxlsb).
PYTHON_PATH=python3

# Необязательно: свой каталог постоянного JSON-хранилища.
# PLAN_FACT_DATA_DIR=/app/data
